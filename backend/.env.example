# Database
DATABASE_URL=postgresql://crm_user:password@localhost:5432/crm_db

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Encryption (AES-256-GCM para API keys)
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-access-key
CLOUDFLARE_R2_SECRET_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=crm-dossiers

# Brevo (email)
BREVO_API_KEY=your-brevo-api-key

# Google OAuth (compartido para todos los proyectos — F2-014)
# Obtener en https://console.cloud.google.com → APIs & Services → Credentials.
# El refresh_token de cada cuenta se guarda en api_credentials.encrypted_value
# (service='google_ads'). El cron googleAdsTokenScheduler valida diariamente.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Opcional: deshabilita el cron de validacion (1=off, vacio=on)
# GOOGLE_TOKEN_DISABLED=
# Intervalo de cron en ms (default 24h)
# GOOGLE_TOKEN_TICK_MS=86400000

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info